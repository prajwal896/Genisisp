{
  "name": "genisis",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "local": "npm run build && npm start",
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"npm --prefix client run dev\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0"
  },
  "devDependencies": { "concurrently": "^9.0.1" }
}
